# ─────────────────────────────────────────────────────────────
# DEMAND FORECAST PLATFORM — Environment Variables Template
# ─────────────────────────────────────────────────────────────
# 1. cp .env.example .env
# 2. Fill in real values in .env
# 3. NEVER commit .env to git — it is in .gitignore
# ─────────────────────────────────────────────────────────────

# JWT — must be at least 32 characters
JWT_SECRET=CHANGE_ME_MIN_32_CHARS_LONG_SECRET_KEY

# Product DB
PRODUCT_DB_USER=product_user
PRODUCT_DB_PASSWORD=CHANGE_ME

# Order DB
ORDER_DB_USER=order_user
ORDER_DB_PASSWORD=CHANGE_ME

# Forecast DB
FORECAST_DB_USER=forecast_user
FORECAST_DB_PASSWORD=CHANGE_ME

# Notification DB
NOTIFICATION_DB_USER=notification_user
NOTIFICATION_DB_PASSWORD=CHANGE_ME

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME

# Slack (optional — for alert notifications)
SLACK_WEBHOOK_PLATFORM=https://hooks.slack.com/services/CHANGE_ME
SLACK_WEBHOOK_INCIDENTS=https://hooks.slack.com/services/CHANGE_ME
